{
  "name": "@vetro-protocol/cli",
  "version": "1.0.0-beta.1",
  "description": "CLI to read and operate on Vetro.",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "_esm",
    "src"
  ],
  "bin": {
    "vetro-cli": "./_esm/cli.js"
  },
  "repository": {
    "directory": "packages/cli",
    "type": "git",
    "url": "git+https://github.com/vetro-protocol/vetro-monorepo.git"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "postbuild": "pnpm bundle",
    "bundle": "node esbuild.js",
    "clean": "rm -rf ./_esm",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@vetro-protocol/gateway": "workspace:*",
    "@vetro-protocol/treasury": "workspace:*",
    "commander": "15.0.0",
    "viem": "2.44.4",
    "viem-erc20": "2.2.0"
  },
  "devDependencies": {
    "@hemilabs/anvil-fork-setup": "2.0.0",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.1.0",
    "@vetro-protocol/core": "workspace:*",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "0.27.3",
    "typescript": "5.9.3",
    "viem-erc4626": "1.0.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
